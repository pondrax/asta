{
  "name": "asta",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "start": "bun ./build/index.js",
    "serve": "pm2 delete asta || true && pm2 start bun --name asta -- run start",
    "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 vite dev",
    "build": "vite build && ./fix.sh",
    "postinstall": "node src/scripts/patch-playwright.mjs || echo 'playwright patch skipped'",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "bun run test:unit -- --run",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun src/lib/server/db/seed.ts",
    "cron": "bun src/scripts/cron.ts",
    "migrate:storage": "bun src/scripts/migrate-storage-s3.ts",
    "test:load": "ab -n 1000 -c 50 http://127.0.0.1:3000/"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.23.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node-cron": "^3.0.11",
    "daisyui": "^5.7.16",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "iconify-icon": "^3.0.2",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6",
    "vite": "^8.2.1",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "apexcharts": "^6.8.0",
    "arktype": "^2.2.3",
    "dayjs": "^1.11.21",
    "jose": "^6.2.8",
    "lottie-web": "^5.13.0",
    "marked": "^18.0.9",
    "node-cron": "^4.6.0",
    "otpauth": "^9.5.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "playwright-core": "^1.62.1",
    "postgres": "^3.4.9",
    "qr-code-styling": "^1.9.2",
    "qr-scanner": "^1.4.2"
  },
  "packageManager": "bun@1.3.2"
}